# Copie para ~/.cloudflared/config.yml (usuario que vai rodar o `cloudflared tunnel create`)
# depois de rodar:
#   cloudflared tunnel login
#   cloudflared tunnel create umucraft
#
# O comando de create imprime o TUNNEL_ID e cria um credentials-file em ~/.cloudflared/<TUNNEL_ID>.json

tunnel: umucraft
credentials-file: /home/SAMBA_USER_PLACEHOLDER/.cloudflared/TUNNEL_ID.json

ingress:
  - hostname: updates.SEUDOMINIO.com
    service: http://localhost:80
  - service: http_status:404
