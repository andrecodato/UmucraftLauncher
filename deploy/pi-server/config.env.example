# Copiado para /etc/umucraft/watcher.env pelo install.sh na primeira execucao.
# Edite os valores e rode: sudo systemctl restart umucraft-watcher

UMU_STAGING_DIR=/srv/umucraft/staging/profiles
UMU_WWW_DIR=/srv/umucraft/www

# URL publica final (a mesma que voce vai configurar no Cloudflare Tunnel).
# Ate configurar o tunnel, pode deixar o IP local do Pi para testar na LAN.
UMU_PUBLIC_BASE_URL=https://updates.SEUDOMINIO.com

# Segundos sem novas mudancas na pasta de mods antes de gerar o zip novo.
UMU_DEBOUNCE_SECONDS=20
