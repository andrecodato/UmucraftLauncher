{
  "name": "UmucraftLauncher",
  "version": "1.1.0",
  "description": "Custom Minecraft Launcher with auto-update for Umucraft servers",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "publish-launcher": "pwsh -ExecutionPolicy Bypass -File deploy/pi-server/publish-launcher.ps1"
  },
  "build": {
    "appId": "com.umucraft.launcher",
    "productName": "Umucraft Launcher",
    "artifactName": "UmuCraftLauncher-Setup-${version}.${ext}",
    "icon": "src/assets/icon.ico",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "src/assets/icon.png",
      "category": "Game"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "src/assets/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [],
    "publish": {
      "provider": "generic",
      "url": "https://umucraft-updates.codato.dev/launcher/",
      "channel": "latest"
    }
  },
  "keywords": [
    "minecraft",
    "launcher",
    "umucraft"
  ],
  "author": "Andre Codato <andrecodato@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.2.0"
  }
}
